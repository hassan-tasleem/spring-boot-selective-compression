<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot Parent -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<!-- Maven Coordinates -->
	<groupId>io.github.hassan-tasleem</groupId>
	<artifactId>spring-boot-selective-compression</artifactId>
	<version>1.0.0</version>

	<!-- Project Information -->
	<name>Spring Boot Selective Compression</name>
	<description>
		Opt-in HTTP response compression for Spring Boot with global,
		class-level, and endpoint-level control.
	</description>

	<url>
		https://github.com/hassan-tasleem/spring-boot-selective-compression
	</url>

	<!-- Java -->
	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<!-- License -->
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<!-- Developer -->
	<developers>
		<developer>
			<name>Hassan Tasleem</name>
			<url>https://github.com/hassan-tasleem</url>
		</developer>
	</developers>

	<!-- Source Code Management -->
	<scm>
		<connection>
			scm:git:git://github.com/hassan-tasleem/spring-boot-selective-compression.git
		</connection>

		<developerConnection>
			scm:git:ssh://git@github.com/hassan-tasleem/spring-boot-selective-compression.git
		</developerConnection>

		<url>
			https://github.com/hassan-tasleem/spring-boot-selective-compression
		</url>

		<tag>HEAD</tag>
	</scm>

	<!-- Dependencies -->
	<dependencies>

		<!-- Spring MVC / Servlet support -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Brotli compression -->
		<dependency>
			<groupId>com.aayushatharva.brotli4j</groupId>
			<artifactId>brotli4j</artifactId>
			<version>1.23.0</version>
		</dependency>

		<!-- Testing -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- Build -->
	<build>
		<plugins>

			<!-- Java compiler -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>21</release>
				</configuration>
			</plugin>

		</plugins>
	</build>

</project>